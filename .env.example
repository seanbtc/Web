# Web 登录门禁配置示例（复制为 .env 或直接在进程/服务管理器里设置环境变量）
# 未配置 WEB_LOGIN_PASSWORD / WEB_LOGIN_PASSWORD_SHA256 时保持旧行为：面板开放访问（不推荐）。

# 登录用户名（默认 admin）
WEB_LOGIN_USERNAME=admin

# 登录密码（明文，二选一；与 SHA256 同时配置时以 SHA256 为准）
WEB_LOGIN_PASSWORD=

# 登录密码的 SHA256 十六进制摘要（二选一；生成方式：
#   python -c "import hashlib;print(hashlib.sha256('你的密码'.encode()).hexdigest())"）
WEB_LOGIN_PASSWORD_SHA256=

# 会话签名密钥；留空则每次启动随机生成，重启后所有登录会话失效（建议固定配置）
WEB_SESSION_SECRET=

# 会话有效期（小时，默认 168 = 7 天）
WEB_SESSION_HOURS=168

# AHR999 日线数据源（可选；默认本机 DataFeed，失败回退 Binance）
WEB_DATAFEED_URL=http://127.0.0.1:9550

# whatif 推演面板（挂载到 /whatif/；可选）
# 指向 whatif/dashboard 目录；不设置时自动探测 Web 同级/上级的 whatif/dashboard。
# 例：WHATIF_DASHBOARD=/home/user/apps/whatif/dashboard
WHATIF_DASHBOARD=

# 仅当 dashboard 与 projects/ 不在同一个 whatif 工作区时，才需要单独指定：
# WHATIF_WORKSPACE=/home/user/apps/whatif
